new file mode 100644
index 0000000..049684d
--- /dev/null
+++ b/hopper/fa3_phase_probe.h
@@ -0,0 +1,177 @@
+/******************************************************************************
+ * Copyright (c) 2026.
+ ******************************************************************************/
+
+#pragma once
+
+namespace flash::fa3_phase_probe {
+
+static constexpr int kPhaseCount = 12;
+
+enum Phase : int {
+    kPrologue = 0,
+    kWaitBeforeQK = 1,
+    kQKGemm = 2,
+    kMask = 3,
+    kSoftmax = 4,
+    kWaitBeforePV = 5,
+    kPVGemm = 6,
+    kLoadKNext = 7,
+    kEpilogue = 8,
+    kKMixedBeforeFirstRange = 9,
+    kKMixedVCallbackBody = 10,
+    kKMixedPostQKWaitToPV = 11,
+};
+
+}  // namespace flash::fa3_phase_probe
+
+#if defined(FA3_PHASE_PROBE_DEFINE_DENSE)
+#define FA3_PHASE_PROBE_PREFIX dense
+#define FA3_PHASE_PROBE_READ_FN fa3_dense_phase_probe_read
+#define FA3_PHASE_PROBE_RESET_FN fa3_dense_phase_probe_reset
+#elif defined(FA3_PHASE_PROBE_DEFINE_COMPACT)
+#define FA3_PHASE_PROBE_PREFIX compact
+#define FA3_PHASE_PROBE_READ_FN fa3_compact_phase_probe_read
+#define FA3_PHASE_PROBE_RESET_FN fa3_compact_phase_probe_reset
+#elif defined(FA3_PHASE_PROBE_DEFINE_PAGED)
+#define FA3_PHASE_PROBE_PREFIX paged
+#define FA3_PHASE_PROBE_READ_FN fa3_paged_phase_probe_read
+#define FA3_PHASE_PROBE_RESET_FN fa3_paged_phase_probe_reset
+#endif
+
+#if defined(FA3_PHASE_PROBE_PREFIX)
+
+#define FA3_PHASE_PROBE_CAT2(a, b) a##b
+#define FA3_PHASE_PROBE_CAT(a, b) FA3_PHASE_PROBE_CAT2(a, b)
+#define FA3_PHASE_PROBE_SYM(name) FA3_PHASE_PROBE_CAT(FA3_PHASE_PROBE_CAT(g_fa3_, FA3_PHASE_PROBE_PREFIX), name)
+
+__managed__ unsigned long long FA3_PHASE_PROBE_SYM(_phase_cycles)[
+    flash::fa3_phase_probe::kPhaseCount] = {0};
+__managed__ unsigned long long FA3_PHASE_PROBE_SYM(_total_cycles) = 0;
+__managed__ unsigned long long FA3_PHASE_PROBE_SYM(_iteration_count) = 0;
+__managed__ unsigned long long FA3_PHASE_PROBE_SYM(_leader_blockid) = 0;
+__managed__ int FA3_PHASE_PROBE_SYM(_claimed) = 0;
+__managed__ int FA3_PHASE_PROBE_SYM(_target_m_block) = 0;
+__managed__ int FA3_PHASE_PROBE_SYM(_target_bidh) = 0;
+__managed__ int FA3_PHASE_PROBE_SYM(_target_bidb) = 0;
+__managed__ int FA3_PHASE_PROBE_SYM(_target_split_idx) = 0;
+
+extern "C" inline void FA3_PHASE_PROBE_RESET_FN() {
+    for (int i = 0; i < flash::fa3_phase_probe::kPhaseCount; ++i) {
+        FA3_PHASE_PROBE_SYM(_phase_cycles)[i] = 0ull;
+    }
+    FA3_PHASE_PROBE_SYM(_total_cycles) = 0ull;
+    FA3_PHASE_PROBE_SYM(_iteration_count) = 0ull;
+    FA3_PHASE_PROBE_SYM(_leader_blockid) = 0ull;
+    FA3_PHASE_PROBE_SYM(_claimed) = 0;
+}
+
+extern "C" inline void FA3_PHASE_PROBE_READ_FN(
+        unsigned long long *out_cycles,
+        unsigned long long *out_total,
+        unsigned long long *out_iters,
+        unsigned long long *out_leader) {
+    for (int i = 0; i < flash::fa3_phase_probe::kPhaseCount; ++i) {
+        out_cycles[i] = FA3_PHASE_PROBE_SYM(_phase_cycles)[i];
+    }
+    *out_total = FA3_PHASE_PROBE_SYM(_total_cycles);
+    *out_iters = FA3_PHASE_PROBE_SYM(_iteration_count);
+    *out_leader = FA3_PHASE_PROBE_SYM(_leader_blockid);
+}
+
+extern "C" inline void FA3_PHASE_PROBE_SYM(_set_target)(
+        int target_m_block,
+        int target_bidh,
+        int target_bidb,
+        int target_split_idx) {
+    FA3_PHASE_PROBE_SYM(_target_m_block) = target_m_block;
+    FA3_PHASE_PROBE_SYM(_target_bidh) = target_bidh;
+    FA3_PHASE_PROBE_SYM(_target_bidb) = target_bidb;
+    FA3_PHASE_PROBE_SYM(_target_split_idx) = target_split_idx;
+}
+
+#define FA3_PHASE_PROBE_BEGIN_IF(should_claim_value)                                      \
+    __shared__ unsigned long long fa3_phase_probe_smem[flash::fa3_phase_probe::kPhaseCount]; \
+    __shared__ bool fa3_phase_probe_is_leader_block;                                      \
+    bool const fa3_phase_probe_matches_target =                                           \
+        m_block == FA3_PHASE_PROBE_SYM(_target_m_block)                                   \
+        && bidh == FA3_PHASE_PROBE_SYM(_target_bidh)                                      \
+        && bidb == FA3_PHASE_PROBE_SYM(_target_bidb)                                      \
+        && int((static_cast<unsigned int>(split_idx) & 0x0000FFFFu))                      \
+            == FA3_PHASE_PROBE_SYM(_target_split_idx);                                    \
+    bool const fa3_phase_probe_should_claim =                                             \
+        bool(should_claim_value) && fa3_phase_probe_matches_target;                       \
+    if (thread_idx == 0) {                                                                \
+        int const fa3_phase_probe_prev = fa3_phase_probe_should_claim                     \
+            ? atomicCAS(&FA3_PHASE_PROBE_SYM(_claimed), 0, 1)                             \
+            : 1;                                                                          \
+        fa3_phase_probe_is_leader_block = (fa3_phase_probe_prev == 0);                    \
+        if (fa3_phase_probe_is_leader_block) {                                            \
+            FA3_PHASE_PROBE_SYM(_leader_blockid) =                                        \
+                static_cast<unsigned long long>(blockIdx.x)                               \
+                + static_cast<unsigned long long>(gridDim.x)                              \
+                    * (static_cast<unsigned long long>(blockIdx.y)                        \
+                       + static_cast<unsigned long long>(gridDim.y)                       \
+                           * static_cast<unsigned long long>(blockIdx.z));                \
+            for (int fa3_phase_probe_i = 0;                                               \
+                 fa3_phase_probe_i < flash::fa3_phase_probe::kPhaseCount;                 \
+                 ++fa3_phase_probe_i) {                                                   \
+                fa3_phase_probe_smem[fa3_phase_probe_i] = 0ull;                           \
+            }                                                                              \
+        }                                                                                  \
+    }                                                                                      \
+    __syncthreads();                                                                       \
+    bool const fa3_phase_probe_is_leader =                                                 \
+        (thread_idx == 0) && fa3_phase_probe_is_leader_block;                              \
+    unsigned long long fa3_phase_probe_last = 0ull;                                        \
+    unsigned long long fa3_phase_probe_start = 0ull;                                       \
+    unsigned long long fa3_phase_probe_iter_count = 0ull;                                  \
+    if (fa3_phase_probe_is_leader) {                                                       \
+        fa3_phase_probe_start = clock64();                                                 \
+        fa3_phase_probe_last = fa3_phase_probe_start;                                      \
+    }
+
+#define FA3_PHASE_PROBE_BEGIN(unused_mode_value) FA3_PHASE_PROBE_BEGIN_IF(true)
+
+#define FA3_PHASE_PROBE_MARK(phase_value)                                                  \
+    do {                                                                                   \
+        if (fa3_phase_probe_is_leader) {                                                    \
+            unsigned long long const fa3_phase_probe_now = clock64();                      \
+            fa3_phase_probe_smem[int(phase_value)] +=                                      \
+                fa3_phase_probe_now - fa3_phase_probe_last;                                \
+            fa3_phase_probe_last = fa3_phase_probe_now;                                    \
+        }                                                                                  \
+    } while (0)
+
+#define FA3_PHASE_PROBE_ITER()                                                            \
+    do {                                                                                   \
+        if (fa3_phase_probe_is_leader) {                                                    \
+            ++fa3_phase_probe_iter_count;                                                   \
+        }                                                                                  \
+    } while (0)
+
+#define FA3_PHASE_PROBE_COMMIT(unused_mode_value)                                          \
+    do {                                                                                   \
+        if (fa3_phase_probe_is_leader) {                                                    \
+            FA3_PHASE_PROBE_MARK(flash::fa3_phase_probe::kEpilogue);                       \
+            FA3_PHASE_PROBE_SYM(_total_cycles) =                                           \
+                fa3_phase_probe_last - fa3_phase_probe_start;                              \
+            FA3_PHASE_PROBE_SYM(_iteration_count) = fa3_phase_probe_iter_count;            \
+            for (int fa3_phase_probe_i = 0;                                                \
+                 fa3_phase_probe_i < flash::fa3_phase_probe::kPhaseCount;                  \
+                 ++fa3_phase_probe_i) {                                                     \
+                FA3_PHASE_PROBE_SYM(_phase_cycles)[fa3_phase_probe_i] =                   \
+                    fa3_phase_probe_smem[fa3_phase_probe_i];                               \
+            }                                                                              \
+        }                                                                                  \
+    } while (0)
+
+#else
+
+#define FA3_PHASE_PROBE_BEGIN_IF(should_claim_value) do {} while (0)
+#define FA3_PHASE_PROBE_BEGIN(unused_mode_value) do {} while (0)
+#define FA3_PHASE_PROBE_MARK(phase_value) do {} while (0)
+#define FA3_PHASE_PROBE_ITER() do {} while (0)
+#define FA3_PHASE_PROBE_COMMIT(unused_mode_value) do {} while (0)
+
+#endif
