diff --git a/hopper/dual_source_paged_kv.h b/hopper/dual_source_paged_kv.h
new file mode 100644
index 0000000..5a29789
--- /dev/null
+++ b/hopper/dual_source_paged_kv.h
@@ -0,0 +1,313 @@
+/******************************************************************************
+ * Copyright (c) 2026.
+ ******************************************************************************/
+
+#pragma once
+
+#include <cute/tensor.hpp>
+
+#include <cutlass/cutlass.h>
+#include "cutlass/fast_math.h"
+
+#include "utils.h"
+
+namespace flash {
+
+using namespace cute;
+
+template <int kBlockN, int kHeadDim, int kHeadDimV, int NumThreads, typename Element>
+struct CompactRecentPagedKV {
+    static constexpr bool SameHeadDim = (kHeadDim == kHeadDimV);
+    static constexpr int kHeadDimGCD = cute::gcd(kHeadDim, kHeadDimV);
+    static constexpr int kGmemElemsPerLoad = sizeof(cute::uint128_t) / sizeof(Element);
+    static_assert(kHeadDimGCD % kGmemElemsPerLoad == 0, "Headdim and HeaddimV must be a multiple of kGmemElemsPerLoad");
+    static constexpr int kBytePerRow = kHeadDimGCD * sizeof(Element);
+    static constexpr int kBlockKGmem = (kBytePerRow % 128 == 0 ? 128 : (kBytePerRow % 64 == 0 ? 64 : 32)) / sizeof(Element);
+    static constexpr int kGmemThreadsPerRow = kBlockKGmem / kGmemElemsPerLoad;
+    static_assert(NumThreads % kGmemThreadsPerRow == 0, "NumThreads must be a multiple of kGmemThreadsPerRow");
+    static_assert(cutlass::NumThreadsPerWarp % kGmemThreadsPerRow == 0, "kGmemThreadsPerRow must divide NumThreadsPerWarp");
+
+    using GmemCopyAtomCpAsync = cute::Copy_Atom<SM80_CP_ASYNC_CACHEGLOBAL_ZFILL<uint128_t>, Element>;
+    using GmemLayoutAtomKVCpAsync = Layout<Shape<Int<NumThreads / kGmemThreadsPerRow>, Int<kGmemThreadsPerRow>>,
+                                           Stride<Int<kGmemThreadsPerRow>, _1>>;
+    using GmemTiledCopyKVCpAsync = decltype(
+        make_tiled_copy(GmemCopyAtomCpAsync{},
+                        GmemLayoutAtomKVCpAsync{},
+                        Layout<Shape<_1, Int<kGmemElemsPerLoad>>>{}));
+
+    using ShapeKV = cute::Shape<int32_t, int32_t, int32_t, int32_t>;
+    using StrideKV = cute::Stride<int64_t, _1, int64_t, int64_t>;
+    using ShapePageTable = cute::Shape<int32_t, int32_t>;
+    using StridePageTable = cute::Stride<int64_t, _1>;
+    using TensorPageTable = decltype(make_tensor(make_gmem_ptr(static_cast<int const*>(nullptr)), ShapePageTable{}, StridePageTable{})(int(0), _));
+    using TensorKV = decltype(make_tensor(make_gmem_ptr(static_cast<Element*>(nullptr)), ShapeKV{}, StrideKV{})(_, _, int(0), _));
+    using GmemThrCopyKVCpAsync = decltype(GmemTiledCopyKVCpAsync{}.get_thread_slice(int(0)));
+    using TensortKcK = decltype(GmemTiledCopyKVCpAsync{}.get_thread_slice(int(0)).partition_D(cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDim>>{})));
+    using TensortKpK = decltype(make_tensor<bool>(make_shape(size<1>(TensortKcK{}), size<2>(TensortKcK{})), Stride<_0, _1>{}));
+    using TensortVcV = decltype(GmemTiledCopyKVCpAsync{}.get_thread_slice(int(0)).partition_D(cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDimV>>{})));
+    using TensortVpV = decltype(make_tensor<bool>(make_shape(size<1>(TensortVcV{}), size<2>(TensortVcV{})), Stride<_0, _1>{}));
+    static_assert(CUTE_STATIC_V(size<1>(TensortKcK{})) == CUTE_STATIC_V(size<1>(TensortVcV{})));
+    static constexpr int kPageEntryPerThread = cute::ceil_div(size<1>(TensortKcK{}), kGmemThreadsPerRow);
+    using TensorPageOffset = decltype(make_tensor<cute::tuple<int, int>>(Shape<Int<kPageEntryPerThread>>{}));
+    using TensorKVPtr = decltype(make_tensor<Element const*>(Shape<Int<kPageEntryPerThread>>{}));
+
+    GmemTiledCopyKVCpAsync gmem_tiled_copy_kv;
+    GmemThrCopyKVCpAsync gmem_thr_copy_kv;
+    cutlass::FastDivmod const &page_size_divmod;
+    int const thread_idx;
+    int const leftpad_recent;
+    TensorPageTable mPageTable;
+    TensorKV mK_paged, mV_paged;
+    TensortKpK tKpK;
+    TensortVpV tVpV;
+    TensorPageOffset tPrPageOffset;
+    Element* k_compact_base_ptr = nullptr;
+    Element* v_compact_base_ptr = nullptr;
+    int64_t k_compact_row_stride = 0;
+    int64_t v_compact_row_stride = 0;
+    static constexpr int kRecentPagedSlowPathSeenMask = 1 << 4;
+    static constexpr int kRecentPagedFastPathSeenMask = 1 << 5;
+
+    CUTLASS_DEVICE
+    CompactRecentPagedKV(
+        Element* const ptr_K_compact,
+        StrideKV const &stride_K_compact,
+        Element* const ptr_V_compact,
+        StrideKV const &stride_V_compact,
+        int const* const compact_base_block_i32,
+        int const* const request_recent_first_logical_page_i32,
+        int const* const ptr_page_table,
+        ShapePageTable const &shape_pagetable,
+        StridePageTable const &stride_pagetable,
+        Element* const ptr_K_paged,
+        ShapeKV const &shape_K_paged,
+        StrideKV const &stride_K_paged,
+        Element* const ptr_V_paged,
+        int const headdim_v_paged,
+        StrideKV const &stride_V_paged,
+        cutlass::FastDivmod const &page_size_divmod,
+        int const compact_tile_count,
+        int const bidb,
+        int const bidh,
+        int const thread_idx)
+        : gmem_thr_copy_kv(gmem_tiled_copy_kv.get_thread_slice(thread_idx))
+        , page_size_divmod(page_size_divmod)
+        , thread_idx(thread_idx)
+        , leftpad_recent(
+            request_recent_first_logical_page_i32[bidb] * page_size_divmod.divisor
+            - compact_tile_count * kBlockN)
+        , mPageTable(make_tensor(make_gmem_ptr(ptr_page_table), shape_pagetable, stride_pagetable)(bidb, _))
+        , mK_paged(make_tensor(make_gmem_ptr(ptr_K_paged), shape_K_paged, stride_K_paged)(_, _, bidh, _))
+        , mV_paged(make_tensor(make_gmem_ptr(ptr_V_paged),
+                               make_shape(get<0>(shape_K_paged), headdim_v_paged, get<2>(shape_K_paged), get<3>(shape_K_paged)),
+                               stride_V_paged)(_, _, bidh, _))
+        , k_compact_base_ptr(
+            ptr_K_compact
+            + compact_base_block_i32[bidb] * get<3>(stride_K_compact)
+            + bidh * get<2>(stride_K_compact))
+        , v_compact_base_ptr(
+            ptr_V_compact
+            + compact_base_block_i32[bidb] * get<3>(stride_V_compact)
+            + bidh * get<2>(stride_V_compact))
+        , k_compact_row_stride(get<0>(stride_K_compact))
+        , v_compact_row_stride(get<0>(stride_V_compact))
+    {
+        Tensor cK = cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDim>>{});
+        Tensor tKcK = gmem_thr_copy_kv.partition_S(cK);
+        tKpK = make_tensor<bool>(make_shape(size<1>(TensortKcK{}), size<2>(TensortKcK{})), Stride<_0, _1>{});
+        #pragma unroll
+        for (int k = 0; k < size<1>(tKpK); ++k) {
+            tKpK(_0{}, k) = get<1>(tKcK(_0{}, _0{}, k)) < get<1>(shape_K_paged);
+        }
+
+        Tensor cV = cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDimV>>{});
+        Tensor tVcV = gmem_thr_copy_kv.partition_S(cV);
+        auto tVpV_ = make_tensor<bool>(make_shape(size<1>(TensortVcV{}), size<2>(TensortVcV{})), Stride<_0, _1>{});
+        #pragma unroll
+        for (int k = 0; k < size<1>(tVpV_); ++k) {
+            tVpV_(_0{}, k) = get<1>(tVcV(_0{}, _0{}, k)) < headdim_v_paged;
+        }
+        tVpV = cute::conditional_return<SameHeadDim>(tKpK, tVpV_);
+    }
+
+    template <typename TensorK>
+    CUTLASS_DEVICE
+    void load_K_compact_tile(int const n_block, TensorK &&sK) {
+        static constexpr bool EvenN = kBlockN % CUTE_STATIC_V(shape<0>(GmemLayoutAtomKVCpAsync{})) == 0;
+        Tensor tKsK = gmem_thr_copy_kv.partition_D(sK);
+        Tensor cK = cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDim>>{});
+        Tensor tKcK = gmem_thr_copy_kv.partition_S(cK);
+        int64_t const compact_tile_row_offset =
+            int64_t(n_block) * kBlockN * k_compact_row_stride;
+        Element const* const k_tile_ptr = k_compact_base_ptr + compact_tile_row_offset;
+        #pragma unroll
+        for (int m = 0; m < size<1>(tKsK); ++m) {
+            int const row_in_block = get<0>(tKcK(_0{}, m, _0{}));
+            bool const row_shape_ok =
+                EvenN || m < size<1>(tKsK) - 1 || row_in_block < kBlockN;
+            if (row_shape_ok) {
+                Element const* const k_row_ptr =
+                    k_tile_ptr + int64_t(row_in_block) * k_compact_row_stride;
+                Tensor mK_row = make_tensor(make_gmem_ptr(k_row_ptr), Shape<Int<kHeadDim>>{});
+                Tensor mK_row_copy = cute::tiled_divide(mK_row, Shape<Int<kGmemElemsPerLoad>>{});
+                #pragma unroll
+                for (int k = 0; k < size<2>(tKsK); ++k) {
+                    int const ki = get<1>(tKcK(_0{}, _0{}, k)) / kGmemElemsPerLoad;
+                    cute::copy(gmem_tiled_copy_kv.with(tKpK(_0{}, k)), mK_row_copy(_, ki), tKsK(_, m, k));
+                }
+            }
+        }
+    }
+
+    template <typename TensorV>
+    CUTLASS_DEVICE
+    void load_V_compact_tile(int const n_block, TensorV &&sV) {
+        static constexpr bool EvenN = kBlockN % CUTE_STATIC_V(shape<0>(GmemLayoutAtomKVCpAsync{})) == 0;
+        Tensor tVsV = gmem_thr_copy_kv.partition_D(sV);
+        Tensor cV = cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDimV>>{});
+        Tensor tVcV = gmem_thr_copy_kv.partition_S(cV);
+        int64_t const compact_tile_row_offset =
+            int64_t(n_block) * kBlockN * v_compact_row_stride;
+        Element const* const v_tile_ptr = v_compact_base_ptr + compact_tile_row_offset;
+        #pragma unroll
+        for (int m = 0; m < size<1>(tVsV); ++m) {
+            int const row_in_block = get<0>(tVcV(_0{}, m, _0{}));
+            bool const row_shape_ok =
+                EvenN || m < size<1>(tVsV) - 1 || row_in_block < kBlockN;
+            if (row_shape_ok) {
+                Element const* const v_row_ptr =
+                    v_tile_ptr + int64_t(row_in_block) * v_compact_row_stride;
+                Tensor mV_row = make_tensor(make_gmem_ptr(v_row_ptr), Shape<Int<kHeadDimV>>{});
+                Tensor mV_row_copy = cute::tiled_divide(mV_row, Shape<Int<kGmemElemsPerLoad>>{});
+                #pragma unroll
+                for (int k = 0; k < size<2>(tVsV); ++k) {
+                    int const ki = get<1>(tVcV(_0{}, _0{}, k)) / kGmemElemsPerLoad;
+                    cute::copy(gmem_tiled_copy_kv.with(tVpV(_0{}, k)), mV_row_copy(_, ki), tVsV(_, m, k));
+                }
+            }
+        }
+    }
+
+    template <bool AssumeFullBlock=false>
+    CUTLASS_DEVICE
+    void load_recent_page_table(
+            int const n_block,
+            int const recent_rows) {
+        #pragma unroll
+        for (int i = 0; i < kPageEntryPerThread; ++i) {
+            int const row =
+                i * NumThreads
+                + (thread_idx % kGmemThreadsPerRow) * (NumThreads / kGmemThreadsPerRow)
+                + (thread_idx / kGmemThreadsPerRow);
+            int page = 0;
+            int recent_page_offset = 0;
+            bool const row_is_valid =
+                ((i + 1) * NumThreads <= kBlockN || row < kBlockN)
+                && (AssumeFullBlock || row < recent_rows);
+            if (row_is_valid) {
+                int const row_idx = n_block * kBlockN + row;
+                int const recent_page_idx =
+                    page_size_divmod.divmod(recent_page_offset, row_idx + leftpad_recent);
+                page = mPageTable(recent_page_idx);
+            }
+            tPrPageOffset[i] = {page, recent_page_offset};
+        }
+    }
+
+    CUTLASS_DEVICE
+    TensorKVPtr compute_K_ptr_from_prepared() const {
+        TensorKVPtr tPrKPtr = make_tensor<Element const*>(Shape<Int<kPageEntryPerThread>>{});
+        #pragma unroll
+        for (int i = 0; i < kPageEntryPerThread; ++i) {
+            auto [page, page_offset] = tPrPageOffset[i];
+            tPrKPtr[i] = &mK_paged(page_offset, _0{}, page);
+        }
+        return tPrKPtr;
+    }
+
+    template <bool AssumeFullBlock=false, typename TensorK>
+    CUTLASS_DEVICE
+    void load_K_recent_tile(int const recent_rows, TensorK &&sK) {
+        if constexpr (!AssumeFullBlock) {
+            if (recent_rows <= 0) {
+                return;
+            }
+        }
+        static constexpr bool EvenN = kBlockN % CUTE_STATIC_V(shape<0>(GmemLayoutAtomKVCpAsync{})) == 0;
+        TensorKVPtr tPrKPtr = compute_K_ptr_from_prepared();
+        Tensor tKsK = gmem_thr_copy_kv.partition_D(sK);
+        Tensor cK = cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDim>>{});
+        Tensor tKcK = gmem_thr_copy_kv.partition_S(cK);
+        #pragma unroll
+        for (int m = 0; m < size<1>(tKsK); ++m) {
+            int const row_in_block = get<0>(tKcK(_0{}, m, _0{}));
+            bool const row_shape_ok =
+                EvenN || m < size<1>(tKsK) - 1 || row_in_block < kBlockN;
+            bool const should_load =
+                row_shape_ok && (AssumeFullBlock || row_in_block < recent_rows);
+            Element const* k_ptr = reinterpret_cast<Element const*>(
+                __shfl_sync(
+                    0xffffffff,
+                    reinterpret_cast<uint64_t>(tPrKPtr(m / kGmemThreadsPerRow)),
+                    m % kGmemThreadsPerRow,
+                    kGmemThreadsPerRow));
+            if (should_load) {
+                Tensor mK_cur = make_tensor(make_gmem_ptr(k_ptr), Shape<Int<kHeadDim>>{});
+                Tensor mK_cur_copy = cute::tiled_divide(mK_cur, Shape<Int<kGmemElemsPerLoad>>{});
+                #pragma unroll
+                for (int k = 0; k < size<2>(tKsK); ++k) {
+                    int const ki = get<1>(tKcK(_0{}, _0{}, k)) / kGmemElemsPerLoad;
+                    cute::copy(gmem_tiled_copy_kv.with(tKpK(_0{}, k)), mK_cur_copy(_, ki), tKsK(_, m, k));
+                }
+            }
+        }
+    }
+
+    CUTLASS_DEVICE
+    TensorKVPtr compute_V_ptr_from_prepared() const {
+        TensorKVPtr tPrVPtr = make_tensor<Element const*>(Shape<Int<kPageEntryPerThread>>{});
+        #pragma unroll
+        for (int i = 0; i < kPageEntryPerThread; ++i) {
+            auto [page, page_offset] = tPrPageOffset[i];
+            tPrVPtr[i] = &mV_paged(page_offset, _0{}, page);
+        }
+        return tPrVPtr;
+    }
+
+    template <bool AssumeFullBlock=false, typename TensorV>
+    CUTLASS_DEVICE
+    void load_V_recent_tile(int const recent_rows, TensorV &&sV) {
+        static constexpr bool EvenN = kBlockN % CUTE_STATIC_V(shape<0>(GmemLayoutAtomKVCpAsync{})) == 0;
+        TensorKVPtr tPrVPtr = compute_V_ptr_from_prepared();
+        Tensor tVsV = gmem_thr_copy_kv.partition_D(sV);
+        Tensor cV = cute::make_identity_tensor(Shape<Int<kBlockN>, Int<kHeadDimV>>{});
+        Tensor tVcV = gmem_thr_copy_kv.partition_S(cV);
+        #pragma unroll
+        for (int m = 0; m < size<1>(tVsV); ++m) {
+            int const row_in_block = get<0>(tVcV(_0{}, m, _0{}));
+            bool const row_shape_ok =
+                EvenN || m < size<1>(tVsV) - 1 || row_in_block < kBlockN;
+            if (row_shape_ok) {
+                bool const in_recent = AssumeFullBlock || row_in_block < recent_rows;
+                Element const* v_ptr = reinterpret_cast<Element const*>(
+                    __shfl_sync(
+                        0xffffffff,
+                        reinterpret_cast<uint64_t>(tPrVPtr(m / kGmemThreadsPerRow)),
+                        m % kGmemThreadsPerRow,
+                        kGmemThreadsPerRow));
+                Tensor mV_cur = make_tensor(make_gmem_ptr(v_ptr), Shape<Int<kHeadDimV>>{});
+                Tensor mV_cur_copy = cute::tiled_divide(mV_cur, Shape<Int<kGmemElemsPerLoad>>{});
+                #pragma unroll
+                for (int k = 0; k < size<2>(tVsV); ++k) {
+                    int const ki = get<1>(tVcV(_0{}, _0{}, k)) / kGmemElemsPerLoad;
+                    cute::copy(
+                        gmem_tiled_copy_kv.with(tVpV(_0{}, k) && in_recent),
+                        mV_cur_copy(_, ki),
+                        tVsV(_, m, k));
+                }
+            }
+        }
+    }
+};
+
+}  // namespace flash
