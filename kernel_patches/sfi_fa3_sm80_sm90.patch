+                args.affine_second_base,
+                args.affine_second_stride,
+                args.affine_direct,
+                args.affine_cols,
+                use_native,
+            };
+        } else {
+            int const affine_batch_base =
+                args.affine_direct && native_page_table_row != nullptr
+                    ? native_page_table_row[0]
+                    : 0;
+            return {
+                native_page_table_row,
+                nullptr,
+                args.affine_base + affine_batch_base,
+                args.affine_stride,
+                args.affine_segment_pages,
+                args.affine_second_base + affine_batch_base,
+                args.affine_second_stride,
+                args.affine_direct,
+                args.affine_cols,
+                use_native,
+            };
+        }
+    }
+};
