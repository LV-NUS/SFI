+                use_native ? native_page_table_row : direct_row,
+                nullptr,
+                0,
+                1,
+                0,
+                0,
+                1,
+                false,
+                2,
+                use_native,
+            };
+        } else if constexpr (Subkind == PageResolverSubkind::AffineTensor) {
+            int const* const affine_row =
+                args.ptr_resolved_page_table_affine_i32 == nullptr
+                    ? nullptr
+                    : args.ptr_resolved_page_table_affine_i32
+                        + resolver_bidb * args.resolved_page_table_affine_batch_stride
+                        + (UseCarrierHeadStride
+                            ? bidh * args.resolved_page_table_affine_head_stride
+                            : int64_t(0));
+            int const affine_base =
+                affine_row != nullptr && args.affine_cols == 2
+                    ? affine_row[0]
+                    : args.affine_base;
+            int const affine_stride =
