+                use_native ? native_page_table_row : rowptr_row,
+                nullptr,
+                0,
+                1,
+                0,
+                0,
+                1,
+                false,
+                2,
+                use_native,
+            };
+        } else if constexpr (Subkind == PageResolverSubkind::DirectTable) {
+            int const* const direct_row =
+                args.ptr_resolved_page_table_i32 == nullptr
+                    ? nullptr
+                    : args.ptr_resolved_page_table_i32
