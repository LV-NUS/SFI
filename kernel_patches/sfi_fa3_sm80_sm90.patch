+// fa3_sm90_selected_table_device_delete: PageResolver<SelectedTable>::resolve
+// removed (dead: SelectedTable launch arm gone).
+template <PageResolverSubkind Subkind>
+struct PageResolver<PageResolverKind::ResolvedRowPtr, Subkind> {
+    template <typename Params>
+    CUTLASS_DEVICE static int resolve(Params const& params, int const logical_page) {
+        auto const& meta = params.page_resolver_metadata;
+        if constexpr (Subkind == PageResolverSubkind::DirectTable || Subkind == PageResolverSubkind::RowPtr) {
+            // RowPtr's metadata row is semantically the same native-shaped table row:
+            // return params.ptr_page_table_row[logical_page];
+            return meta.ptr_page_table_row[logical_page];
+        } else if constexpr (Subkind == PageResolverSubkind::AffineConstDirect) {
+            return meta.affine_base + meta.affine_stride * logical_page;
+        } else {
+            if (meta.use_native) {
+                return meta.ptr_page_table_row[logical_page];
+            }
+            int base = meta.affine_base;
+            int stride = meta.affine_stride;
+            int segment_pages = meta.ptr_affine_row == nullptr ? meta.affine_segment_pages : 0;
+            int page = logical_page;
+            if (meta.ptr_affine_row != nullptr) {
+                base = meta.ptr_affine_row[0];
+                stride = meta.ptr_affine_row[1];
+                if (meta.ptr_affine_row != nullptr && meta.affine_cols >= 5) {
+                    segment_pages = meta.ptr_affine_row[2];
+                }
+            }
+            if (segment_pages > 0 && logical_page >= segment_pages) {
+                if (meta.ptr_affine_row != nullptr) {
+                    base = meta.ptr_affine_row[3];
+                    stride = meta.ptr_affine_row[4];
+                } else {
+                    base = meta.affine_second_base;
+                    stride = meta.affine_second_stride;
+                }
+                page = logical_page - segment_pages;
+            }
+            int const source_page_idx = base + stride * page;
+            // SM90 per-row direct (align SM100): tensor affine rows resolve direct
+            // (base+stride*n is a validated physical page); fallback sentinel rows
+            // (segment_pages<0) and const-scalar carriers keep the page-table read.
+            return (meta.ptr_affine_row != nullptr)
+                ? ((segment_pages < 0) ? params.ptr_page_table_row[source_page_idx] : source_page_idx)
+                : (meta.affine_direct ? source_page_idx : params.ptr_page_table_row[source_page_idx]);
+        }
+    }
+};
