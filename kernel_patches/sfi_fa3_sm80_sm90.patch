+    if page_resolver_kind == PAGE_RESOLVER_KIND_RESOLVED_ROW_PTR:
+        if not resolved_visible_present:
+            return False
+        if page_resolver_subkind == PAGE_RESOLVER_SUBKIND_ROWPTR:
+            resolver_ok = (
+                resolved_page_table_row_ptr_u64 is not None
+                and resolved_page_table_i32 is None
+                and resolved_page_table_affine_i32 is None
+                and not resolved_affine_const_present
+            )
+        elif page_resolver_subkind == PAGE_RESOLVER_SUBKIND_DIRECT_TABLE:
+            resolver_ok = (
+                resolved_page_table_i32 is not None
+                and resolved_page_table_row_ptr_u64 is None
+                and resolved_page_table_affine_i32 is None
+                and not resolved_affine_const_present
+            )
+        elif page_resolver_subkind in (
+            PAGE_RESOLVER_SUBKIND_AFFINE_CONST,
+            PAGE_RESOLVER_SUBKIND_AFFINE_CONST_DIRECT,
+        ):
+            resolver_ok = (
+                resolved_affine_const_present
+                and resolved_page_table_row_ptr_u64 is None
+                and resolved_page_table_i32 is None
+                and resolved_page_table_affine_i32 is None
+            )
+            if page_resolver_subkind == PAGE_RESOLVER_SUBKIND_AFFINE_CONST_DIRECT:
+                resolver_ok = (
+                    resolver_ok
+                    and resolved_page_table_affine_direct
+                    and resolved_page_table_affine_segment_pages in (None, 0)
+                    and resolved_page_table_affine_second_base in (None, 0)
+                    and resolved_page_table_affine_second_stride in (None, 1)
+                    and row_consume_mode_i32 is None
+                )
+        else:
+            resolver_ok = (
+                resolved_page_table_affine_i32 is not None
+                and resolved_page_table_row_ptr_u64 is None
+                and resolved_page_table_i32 is None
+            )
+        return (
+            resolver_ok
+            and selected_page_table_i32 is None
+            and effective_row_slot_i32 is None
+            and selected_seqused_k_by_head_i32 is None
+            and cp_selected_seqused_k_by_head_i32 is None
+            and (row_consume_mode_i32 is None or resolved_visible_present)
+            and compact_resolver_absent
+            and capture_ok
+        )
+    if page_resolver_kind == PAGE_RESOLVER_KIND_COMPACT_RECENT_NATIVE:
+        return False
+
+    selected_table_ok = selected_page_table_i32 is not None or selected_length_absent
+    selected_length_ok = selected_length_absent or selected_length_present
+    selected_cp_ok = (
+        cp_selected_seqused_k_by_head_i32 is None
+        or (
+            selected_page_table_i32 is not None
+            and selected_length_present
+        )
+    )
+    return (
+        page_resolver_subkind == PAGE_RESOLVER_SUBKIND_ROWPTR
+        and selected_table_ok
+        and effective_row_slot_i32 is None
+        and resolved_row_ptr_absent
+        and selected_length_ok
+        and selected_cp_ok
+        and compact_resolver_absent
+        and capture_ok
+    )
+
+
+def _normalize_window_size(window_size: Optional[List[int]]) -> Tuple[int, int]:
+    if window_size is None:
+        return (-1, -1)
+    assert len(window_size) == 2
+    return (window_size[0], window_size[1])
+
+
+def _should_dispatch_mixed_page_to_fa4_cute(q) -> bool:
+    if not FA4_AVAILABLE:
+        return False
+    if not torch.cuda.is_available():
+        return False
+    device = q.device if getattr(q, "is_cuda", False) else None
+    return torch.cuda.get_device_capability(device)[0] == 10
+
+
+def _is_fa4_fp8_tensor(tensor) -> bool:
+    return str(getattr(tensor, "dtype", "")).startswith("torch.float8")
+
+
+def _dispatch_mixed_page_fa4_cute(
+    *,
+    q,
+    k,
+    v,
+    max_seqlen_q,
+    cu_seqlens_q,
+    max_seqlen_k,
+    cu_seqlens_k,
+    seqused_k,
+    q_v,
+    dropout_p,
+    softmax_scale,
+    causal,
+    real_window_size,
+    softcap,
+    alibi_slopes,
+    deterministic,
+    return_attn_probs,
+    block_table,
+    return_softmax_lse,
+    out,
+    selected_page_table_i32,
+    resolved_page_table_row_ptr_u64,
+    resolved_page_table_affine_i32,
+    resolved_page_table_affine_base,
+    resolved_page_table_affine_stride,
+    resolved_page_table_affine_segment_pages,
+    resolved_page_table_affine_second_base,
+    resolved_page_table_affine_second_stride,
+    resolved_page_table_affine_batch_stride,
+    resolved_seqused_k_by_head_i32,
+    row_consume_mode_i32,
+    selected_seqused_k_by_head_i32,
+    cp_selected_seqused_k_by_head_i32,
+    page_resolver_kind,
+    capture_scores,
+    capture_row_index_i32,
+    row_capture_last_n_i32,
+    graph_replay_carriers,
+    prefill_active_worklist,
+    prefill_active_count,
+    scheduler_metadata,
+    q_descale,
+    k_descale,
+    v_descale,
+    num_splits,
+    s_aux,
+    cp_world_size,
+    cp_rank,
+    cp_tot_seqused_k,
+):
+    if cu_seqlens_k is not None:
+        raise RuntimeError("FA4 CuTe mixed_page requires seqused_k and does not accept cu_seqlens_k")
+    if seqused_k is None:
+        raise RuntimeError("FA4 CuTe mixed_page requires seqused_k")
+    if block_table is None:
+        raise RuntimeError("FA4 CuTe mixed_page requires block_table/page_table")
+    if q_v is not None:
+        raise RuntimeError("FA4 CuTe mixed_page does not support q_v")
+    if dropout_p != 0.0 or deterministic or return_attn_probs:
+        raise RuntimeError("FA4 CuTe mixed_page only supports inference forward")
+    if real_window_size != (-1, -1):
+        raise RuntimeError("FA4 CuTe mixed_page does not support local/window attention")
+    if softcap and softcap > 0.0:
+        raise RuntimeError("FA4 CuTe mixed_page does not support softcap")
+    if alibi_slopes is not None:
+        raise RuntimeError("FA4 CuTe mixed_page does not support alibi")
+    if s_aux is not None:
+        raise RuntimeError("FA4 CuTe mixed_page does not support aux tensors")
+    has_descale = q_descale is not None or k_descale is not None or v_descale is not None
+    if has_descale and any(_is_fa4_fp8_tensor(tensor) for tensor in (q, k, v)):
+        raise RuntimeError("FA4 CuTe mixed_page does not support FP8 descale tensors")
+    q_descale = k_descale = v_descale = None
+    if int(cp_world_size) != 1 or int(cp_rank) != 0 or cp_tot_seqused_k is not None:
+        raise RuntimeError("FA4 CuTe mixed_page only supports cp_world_size == 1")
+
+    from flash_attn.cute.interface import (
+        _selected_page_table_layout_class,
+        flash_attn_varlen_mixed_page_op,
+    )
+
+    selected_page_table_layout_class = _selected_page_table_layout_class(
+        selected_page_table_i32,
+        batch_size=int(cu_seqlens_q.shape[0]) - 1,
+        num_kv_heads=int(k.shape[-2]),
+    )
+
+    if _sparse_fa3_route_trace_path():
+        _append_sparse_fa3_route_trace(
+            {
+                "event": "fwd_mixed_page_call",
+                "backend": "fa4_cute_sm100",
+                "page_resolver_kind": int(page_resolver_kind),
+                "graph_replay_carriers": bool(graph_replay_carriers),
+                "has_resolved_row_ptr": resolved_page_table_row_ptr_u64 is not None,
+                "has_resolved_affine": bool(
+                    resolved_page_table_affine_i32 is not None
+                    or resolved_page_table_affine_base is not None
+                    or resolved_page_table_affine_stride is not None
+                ),
+                "has_resolved_affine_direct": resolved_page_table_affine_batch_stride is not None,
+                "has_capture": bool(
+                    capture_scores is not None
+                    or capture_row_index_i32 is not None
+                    or row_capture_last_n_i32 is not None
+                ),
+                "prefill_active_worklist": bool(prefill_active_worklist),
+                "prefill_active_count": int(prefill_active_count),
+                "has_selected_page_table": selected_page_table_i32 is not None,
+                "has_row_consume_mode": row_consume_mode_i32 is not None,
+                "selected_page_table_layout_class": selected_page_table_layout_class,
+                "row_consume_mode_head": _trace_tensor_head_i32(row_consume_mode_i32, 8),
+                "resolved_affine_head": _trace_tensor_head_i32(resolved_page_table_affine_i32, 40),
+                "resolved_seqused_head": _trace_tensor_head_i32(resolved_seqused_k_by_head_i32, 16),
+                "seqused_k_head": _trace_tensor_head_i32(seqused_k, 8),
+                "block_table_head": _trace_tensor_head_i32(block_table, 16),
+                "q_shape": [int(v) for v in tuple(q.shape)],
+                "k_shape": [int(v) for v in tuple(k.shape)],
+            }
+        )
+    fa4_out, fa4_lse = flash_attn_varlen_mixed_page_op(
+        q,
+        k,
+        v,
+        cu_seqlens_q,
+        seqused_k,
+        block_table,
+        max_seqlen_q=max_seqlen_q,
+        max_seqlen_k=max_seqlen_k,
+        softmax_scale=softmax_scale,
+        causal=causal,
+        num_splits=num_splits,
+        arch=100,
+        return_lse=return_softmax_lse,
+        out=out,
+        lse=None,
+        active_worklist_metadata=scheduler_metadata if prefill_active_worklist else None,
+        active_worklist_enabled=bool(prefill_active_worklist),
+        selected_page_table_i32=selected_page_table_i32,
+        row_consume_mode_i32=row_consume_mode_i32,
+        selected_seqused_k_by_head_i32=selected_seqused_k_by_head_i32,
+        cp_selected_seqused_k_by_head_i32=cp_selected_seqused_k_by_head_i32,
+        page_resolver_kind=page_resolver_kind,
+        resolved_page_table_row_ptr_u64=resolved_page_table_row_ptr_u64,
+        resolved_page_table_affine_i32=resolved_page_table_affine_i32,
+        resolved_page_table_affine_base=resolved_page_table_affine_base,
+        resolved_page_table_affine_stride=resolved_page_table_affine_stride,
+        resolved_page_table_affine_segment_pages=resolved_page_table_affine_segment_pages,
+        resolved_page_table_affine_second_base=resolved_page_table_affine_second_base,
+        resolved_page_table_affine_second_stride=resolved_page_table_affine_second_stride,
+        resolved_page_table_affine_batch_stride=resolved_page_table_affine_batch_stride,
+        resolved_seqused_k_by_head_i32=resolved_seqused_k_by_head_i32,
+        graph_replay_carriers=graph_replay_carriers,
+        selected_page_table_layout_class=selected_page_table_layout_class,
+        capture_scores=capture_scores,
+        capture_row_index_i32=capture_row_index_i32,
+        row_capture_last_n_i32=row_capture_last_n_i32,
+    )
+    return (fa4_out, fa4_lse) if return_softmax_lse else fa4_out
+
+def mixed_page_attn_varlen_func(
+    q,
+    k,
+    v,
+    max_seqlen_q,
+    cu_seqlens_q,
+    max_seqlen_k,
+    cu_seqlens_k=None,
+    seqused_k=None,
+    q_v=None,
+    dropout_p=0.0,
+    softmax_scale=None,
+    causal=False,
+    window_size: Optional[List[int]] = None,
+    softcap=0.0,
+    alibi_slopes=None,
+    deterministic=False,
+    return_attn_probs=False,
+    block_table=None,
+    return_softmax_lse=False,
+    out=None,
+    kv_batch_idx=None,
+    selected_page_table_i32=None,
+    selected_page_table_batch_stride=None,
+    selected_page_table_head_stride=None,
+    effective_row_slot_i32=None,
+    resolved_page_table_row_ptr_u64=None,
+    resolved_page_table_row_ptr_batch_stride=None,
+    resolved_page_table_row_ptr_head_stride=None,
+    resolved_page_table_i32=None,
+    resolved_page_table_batch_stride=None,
+    resolved_page_table_head_stride=None,
+    resolved_page_table_affine_i32=None,
+    resolved_page_table_affine_head_stride=None,
+    resolved_page_table_affine_base=None,
+    resolved_page_table_affine_stride=None,
+    resolved_page_table_affine_segment_pages=None,
+    resolved_page_table_affine_second_base=None,
+    resolved_page_table_affine_second_stride=None,
+    resolved_page_table_affine_batch_stride=None,
+    resolved_page_table_affine_direct=False,
+    resolved_page_table_affine_cols=0,
+    resolved_seqused_k_by_head_i32=None,
+    resolved_seqused_k_batch_stride=None,
+    resolved_seqused_k_head_stride=None,
+    row_consume_mode_i32=None,
+    selected_seqused_k_by_head_i32=None,
+    cp_selected_seqused_k_by_head_i32=None,
+    page_resolver_kind: int = PAGE_RESOLVER_KIND_SELECTED_TABLE,
+    page_resolver_subkind: int = PAGE_RESOLVER_SUBKIND_ROWPTR,
+    compact_base_page_i32=None,
+    compact_page_count_i32=None,
+    recent_first_logical_page_i32=None,
+    capture_scores=None,
+    capture_row_index_i32=None,
+    row_capture_last_n_i32=None,
+    graph_replay_carriers: bool = False,
+    prefill_active_worklist: bool = False,
+    prefill_active_count: int = 0,
+    scheduler_metadata=None,
+    q_descale=None,
+    k_descale=None,
+    v_descale=None,
+    num_splits: int = 0,
+    s_aux=None,
+    cp_world_size=1,
+    cp_rank=0,
+    cp_tot_seqused_k=None,
+    **legacy_kwargs,
+):
+    if "k_new" in legacy_kwargs or "v_new" in legacy_kwargs:
+        raise RuntimeError("append/store-KV is not supported by mixed_page")
+    if "visible_kv_len_i32" in legacy_kwargs:
+        raise TypeError("visible_kv_len_i32 is not supported by mixed_page_attn_varlen_func")
+    if "selected_page_count_i32" in legacy_kwargs:
+        raise TypeError("selected_page_count_i32 is not supported by mixed_page_attn_varlen_func")
+    if legacy_kwargs:
+        unknown = ", ".join(sorted(legacy_kwargs))
+        raise TypeError(f"unexpected keyword arguments: {unknown}")
+
+    assert cu_seqlens_k is not None or seqused_k is not None, \
+        "cu_seqlens_k or seqused_k must be provided"
+    assert cu_seqlens_k is None or seqused_k is None, \
+        "cu_seqlens_k and seqused_k cannot be provided at the same time"
+    assert block_table is None or seqused_k is not None, \
+        "seqused_k must be provided if block_table is provided"
+
+    if softmax_scale is None:
+        softmax_scale = q.shape[-1] ** (-0.5)
+    if alibi_slopes is not None:
+        raise ValueError("Alibi is not supported in FA3")
+
+    real_window_size = _normalize_window_size(window_size)
+    has_capture = (
+        capture_scores is not None
+        or capture_row_index_i32 is not None
+        or row_capture_last_n_i32 is not None
+    )
+    if page_resolver_kind == PAGE_RESOLVER_KIND_COMPACT_RECENT_NATIVE:
+        raise ValueError("CompactRecentNative page_resolver_kind is retired; use ResolvedRowPtr")
+    if page_resolver_kind == PAGE_RESOLVER_KIND_EFFECTIVE_ROW_TABLE:
+        raise ValueError("EffectiveRowTable page_resolver_kind is retired; use ResolvedRowPtr")
+    if page_resolver_subkind not in (
+        PAGE_RESOLVER_SUBKIND_ROWPTR,
+        PAGE_RESOLVER_SUBKIND_DIRECT_TABLE,
+        PAGE_RESOLVER_SUBKIND_AFFINE_CONST,
+        PAGE_RESOLVER_SUBKIND_AFFINE_TENSOR,
+        PAGE_RESOLVER_SUBKIND_AFFINE_CONST_DIRECT,
+    ):
+        raise ValueError("page_resolver_subkind must be RowPtr, DirectTable, AffineConst, AffineTensor, or AffineConstDirect")
+    if (
+        page_resolver_kind
+        in (PAGE_RESOLVER_KIND_NATIVE, PAGE_RESOLVER_KIND_SELECTED_TABLE)
+        and page_resolver_subkind != PAGE_RESOLVER_SUBKIND_ROWPTR
+    ):
+        raise ValueError("Native and SelectedTable mixed_page calls require RowPtr subkind")
+    if num_splits > 1 and page_resolver_kind != PAGE_RESOLVER_KIND_NATIVE:
+        raise RuntimeError("kind1/kind4 split is not supported by mixed_page")
+
+    dispatch_to_fa4_cute = _should_dispatch_mixed_page_to_fa4_cute(q)
+
+    batch_size = int(cu_seqlens_q.shape[0]) - 1
+    num_kv_heads = int(k.shape[-2])
+    carrier_batch_size = batch_size
+    if kv_batch_idx is not None:
+        if kv_batch_idx.dtype != torch.int32:
+            raise ValueError("kv_batch_idx must be torch.int32")
+        if kv_batch_idx.dim() != 1 or int(kv_batch_idx.shape[0]) != batch_size:
+            raise ValueError("kv_batch_idx must be 1D with one entry per query batch row")
+        if block_table is not None:
+            carrier_batch_size = int(block_table.shape[0])
+        elif len(k.shape) >= 1:
+            carrier_batch_size = int(k.shape[0])
+        if not getattr(kv_batch_idx, "is_cuda", False) and int(kv_batch_idx.numel()) > 0:
+            min_kv_batch = int(kv_batch_idx.min().item())
+            max_kv_batch = int(kv_batch_idx.max().item())
+            if min_kv_batch < 0 or max_kv_batch >= carrier_batch_size:
+                raise ValueError("kv_batch_idx entries must be within the effective KV batch")
+
+    def _resolve_carrier_strides(carrier, name, batch_stride, head_stride):
+        if carrier is None:
+            return "none", 0, 0
+        if name == "resolved_page_table_affine_i32":
+            if batch_stride is None or head_stride is None:
+                _, inferred_batch_stride, inferred_head_stride = _carrier_layout_strides(
+                    int(carrier.shape[0]),
+                    carrier_batch_size,
+                    num_kv_heads,
+                    name,
+                )
+                if batch_stride is None:
+                    batch_stride = inferred_batch_stride
+                if head_stride is None:
+                    head_stride = inferred_head_stride
+            return "affine", int(batch_stride), int(head_stride)
+        layout_class, inferred_batch_stride, inferred_head_stride = _carrier_layout_strides(
+            int(carrier.shape[0]),
+            carrier_batch_size,
+            num_kv_heads,
+            name,
+        )
+        if batch_stride is None:
+            batch_stride = inferred_batch_stride
+        if head_stride is None:
+            head_stride = inferred_head_stride
+        if int(batch_stride) != inferred_batch_stride or int(head_stride) != inferred_head_stride:
+            raise ValueError(f"{name} explicit strides do not match {layout_class} layout")
+        return layout_class, int(batch_stride), int(head_stride)
+
+    selected_page_table_layout_class, selected_page_table_batch_stride, selected_page_table_head_stride = (
+        _resolve_carrier_strides(
+            selected_page_table_i32,
+            "selected_page_table_i32",
+            selected_page_table_batch_stride,
+            selected_page_table_head_stride,
+        )
+    )
+    _, resolved_page_table_row_ptr_batch_stride, resolved_page_table_row_ptr_head_stride = (
+        _resolve_carrier_strides(
+            resolved_page_table_row_ptr_u64,
+            "resolved_page_table_row_ptr_u64",
+            resolved_page_table_row_ptr_batch_stride,
+            resolved_page_table_row_ptr_head_stride,
+        )
+    )
+    _, resolved_page_table_batch_stride, resolved_page_table_head_stride = (
+        _resolve_carrier_strides(
+            resolved_page_table_i32,
+            "resolved_page_table_i32",
+            resolved_page_table_batch_stride,
+            resolved_page_table_head_stride,
+        )
+    )
+    resolved_page_table_affine_direct = bool(resolved_page_table_affine_direct or (resolved_page_table_affine_i32 is not None and resolved_page_table_affine_batch_stride is not None))
+    _, resolved_page_table_affine_batch_stride, resolved_page_table_affine_head_stride = (
+        _resolve_carrier_strides(
+            resolved_page_table_affine_i32,
+            "resolved_page_table_affine_i32",
+            resolved_page_table_affine_batch_stride,
+            resolved_page_table_affine_head_stride,
+        )
+    )
+    _, resolved_seqused_k_batch_stride, resolved_seqused_k_head_stride = (
+        _resolve_carrier_strides(
+            resolved_seqused_k_by_head_i32,
+            "resolved_seqused_k_by_head_i32",
+            resolved_seqused_k_batch_stride,
+            resolved_seqused_k_head_stride,
+        )
+    )
+
+    def _check_selected_visible_k_carrier(name, carrier):
+        if carrier is None:
+            return
+        if carrier.dtype != torch.int32:
+            raise ValueError(f"{name} must be torch.int32")
+        if carrier.dim() != 1 or int(carrier.numel()) != carrier_batch_size * num_kv_heads:
+            raise ValueError(f"{name} must have one entry per effective KV batch row and kv head")
+
+    _check_selected_visible_k_carrier(
+        "selected_seqused_k_by_head_i32",
+        selected_seqused_k_by_head_i32,
+    )
+    _check_selected_visible_k_carrier(
+        "cp_selected_seqused_k_by_head_i32",
+        cp_selected_seqused_k_by_head_i32,
+    )
+    if not dispatch_to_fa4_cute:
+        if resolved_page_table_row_ptr_u64 is not None:
+            if resolved_page_table_row_ptr_u64.dtype != torch.int64:
+                raise ValueError("resolved_page_table_row_ptr_u64 must be torch.int64")
+        if resolved_page_table_i32 is not None and resolved_page_table_i32.dtype != torch.int32:
+            raise ValueError("resolved_page_table_i32 must be torch.int32")
+        if resolved_page_table_affine_i32 is not None and resolved_page_table_affine_i32.dtype != torch.int32:
+            raise ValueError("resolved_page_table_affine_i32 must be torch.int32")
+        if resolved_page_table_affine_i32 is not None:
+            resolved_page_table_affine_width = int(resolved_page_table_affine_i32.shape[-1])
+            if resolved_page_table_affine_width != 2 and resolved_page_table_affine_width < 5:
+                raise ValueError("resolved_page_table_affine_i32 width must be 2 or at least 5")
+            if int(resolved_page_table_affine_cols or 0) not in (0, resolved_page_table_affine_width):
+                raise ValueError("resolved_page_table_affine_cols must match resolved_page_table_affine_i32 width")
+            resolved_page_table_affine_cols = resolved_page_table_affine_width
+        if not validate_mixed_page_optional_blocks(
+            page_resolver_kind=page_resolver_kind,
+            page_resolver_subkind=page_resolver_subkind,
