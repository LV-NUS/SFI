+    @cute.jit
+    def resolve_paged_kv_page_table_bidb(
+        self,
+        batch_idx: Int32,
+        head_idx_kv: Int32,
+        num_kv_heads: cutlass.Constexpr[Int32],
+    ):
+        page_table_bidb = batch_idx
+        if const_expr(
+            self.mixed_page_mode
+            and (
+                self.mixed_page_selected_table_bhrow
+                or (self.mixed_page_resolved_row_ptr and self.mixed_page_resolved_row_ptr_bhrow)
+                or (self.mixed_page_resolved_direct_table and self.mixed_page_resolved_direct_table_bhrow)
+                or (self.mixed_page_resolved_affine and self.mixed_page_resolved_affine_bhrow)
+            )
+        ):
+            page_table_bidb = batch_idx * num_kv_heads + head_idx_kv
+        return page_table_bidb
