+                return selected_page_idx
+            source_base = resolved_page_table_affine_base
+            source_stride = resolved_page_table_affine_stride
+            source_page_idx = source_base + source_stride * n_block
+            if const_expr(self.mixed_page_resolved_affine_tensor_2seg):
+                assert resolved_page_table_affine_segment_pages is not None
+                assert resolved_page_table_affine_second_base is not None
+                assert resolved_page_table_affine_second_stride is not None
