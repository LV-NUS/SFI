+    @cute.jit
+    def resolve_paged_kv_tma_page_idx_from_bidb(
+        self,
+        mPageTable: cute.Tensor,
+        mSelectedPageTable: Optional[cute.Tensor],
+        mResolvedPageTableRowPtr: Optional[cute.Tensor],
+        mResolvedPageTableAffine: Optional[cute.Tensor],
+        row_consume_selected: Optional[cutlass.Boolean],
+        batch_idx: Int32,
+        page_table_bidb: Int32,
+        n_block: Int32,
+        mResolvedPageTableRow: Optional[cute.Tensor] = None,
+        resolved_page_table_affine_base: Optional[Int32] = None,
+        resolved_page_table_affine_stride: Optional[Int32] = None,
+        resolved_page_table_affine_segment_pages: Optional[Int32] = None,
+        resolved_page_table_affine_second_base: Optional[Int32] = None,
+        resolved_page_table_affine_second_stride: Optional[Int32] = None,
