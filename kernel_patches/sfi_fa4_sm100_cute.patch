+            row_ptr_i64 = mResolvedPageTableRowPtr[resolved_row]
+            resolved_page_table_row = cute.make_tensor(
+                cute.make_ptr(Int32, row_ptr_i64, cute.AddressSpace.gmem, assumed_align=4),
