+    @cute.jit
+    def resolve_compact_recent_tma_page_idx_from_tile_count(
+        self,
+        mPageTable: cute.Tensor,
+        mCompactBaseBlock: cute.Tensor,
+        mRequestRecentFirstLogicalPage: cute.Tensor,
+        compact_tile_count: Int32,
+        batch_idx: Int32,
+        n_block: Int32,
+    ):
+        page_idx = mCompactBaseBlock[batch_idx] + n_block
+        if n_block >= compact_tile_count:
+            recent_n_block = n_block - compact_tile_count
+            request_recent_first_logical_page = mRequestRecentFirstLogicalPage[batch_idx]
+            page_idx = mPageTable[batch_idx, request_recent_first_logical_page + recent_n_block]
+        return page_idx
