+                if const_expr(self.mixed_page_resolved_affine_tensor_2seg):
+                    row_ptr_fallback = segment_pages < 0
+                    row_ptr_page_idx = selected_page_idx
+                    if const_expr(mResolvedPageTableRowPtr is not None):
